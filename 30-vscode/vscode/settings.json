{
	"workbench.startupEditor": "none",
	"workbench.iconTheme": "symbols",
	"workbench.editor.tabSizing": "fixed",
	"workbench.editor.tabSizingFixedMaxWidth": 150,
	"workbench.colorTheme": "Monokai Night",
	"workbench.productIconTheme": "fluent-icons",
	"workbench.secondarySideBar.defaultVisibility": "hidden",
	"editor.wordWrap": "off",
	"editor.codeLens": true,
	"editor.minimap.enabled": false,
	"editor.formatOnSave": true,
	"editor.bracketPairColorization.enabled": true,
	"editor.scrollbar.verticalScrollbarSize": 8,
	"editor.scrollbar.horizontalScrollbarSize": 5,
	"editor.guides.bracketPairs": true,
	"editor.linkedEditing": true,
	"editor.fontLigatures": true,
	"editor.fontFamily": "Cascadia Code, Consolas, 'Courier New', monospace",
	"editor.cursorBlinking": "expand",
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.detectIndentation": false,
	"editor.tabSize": 2,
	"editor.insertSpaces": false,
	"editor.tokenColorCustomizations": {
		"comments": "#9a9c9a",
	},
	"terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font",
	"terminal.integrated.defaultProfile.windows": "PowerShell",
	"explorer.confirmDelete": false,
	"security.workspace.trust.banner": "never",
	// Save on tab or window change, not on a timer: format on save does not run on delayed
	// auto-saves ("afterDelay").
	"files.autoSave": "onFocusChange",
	"files.eol": "\n",
	"css.enabledLanguages": ["html"],
	"explorer.confirmDragAndDrop": false,
	"auto-close-tag.enableAutoCloseTag": true,
	"auto-rename-tag.activationOnLanguage": ["html", "xml", "php", "javascript"],
	"auto-close-tag.activationOnLanguage": [
		"xml",
		"php",
		"blade",
		"ejs",
		"jinja",
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact",
		"plaintext",
		"markdown",
		"vue",
		"liquid",
		"erb",
		"lang-cfml",
		"cfml",
		"HTML (EEx)",
		"HTML (Eex)",
		"plist",
	],
	"terminal.integrated.profiles.windows": {
		"PowerShell": {
			"source": "PowerShell",
			"icon": "terminal-powershell",
		},
		"Command Prompt": {
			"path": ["${env:windir}\\Sysnative\\cmd.exe", "${env:windir}\\System32\\cmd.exe"],
			"args": [],
			"icon": "terminal-cmd",
		},
		"Git Bash": {
			"source": "Git Bash",
		},
		"Windows PowerShell": {
			"path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
		},
	},
	"html.format.wrapLineLength": 130,
	"git.enableSmartCommit": true,
	"symbols.hidesExplorerArrows": false,
	"editor.stickyScroll.enabled": false,
	// The style does not live here but in files the Prettier CLI also reads: each project's
	// .prettierrc or, without one, the global one (40-format/, linked in ~ and in <drive>\Dev).
	// That way the editor, the terminal and CI format the same.
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnPaste": true,
	"mssql.connectionGroups": [
		{
			"name": "ROOT",
			"id": "ROOT",
		},
	],
	// What Prettier does not format, with its native tool. shfmt without flags reads the
	// project's .editorconfig (indentation and switch_case_indent).
	"[shellscript]": {
		"editor.defaultFormatter": "mkhl.shfmt",
	},
	"[sql]": {
		"editor.defaultFormatter": "mtxr.sqltools",
	},
	"sonarlint.connectedMode.connections.sonarcloud": [
		{
			"organizationKey": "m1gu3l4ng3l-org",
			"connectionId": "m1gu3l4ngel",
			"region": "EU",
		},
	],
	"terminal.integrated.initialHint": false,
	"claudeCode.preferredLocation": "panel",
	"sqltools.highlightQuery": false,
	"json.schemaDownload.trustedDomains": {
		"https://developer.microsoft.com/json-schemas/": true,
		"https://json-schema.org/": true,
		"https://json.schemastore.org/": true,
		"https://raw.githubusercontent.com/devcontainers/spec/": true,
		"https://raw.githubusercontent.com/microsoft/vscode/": true,
		"https://schemastore.azurewebsites.net/": true,
		"https://ui.shadcn.com/schema.json": true,
		"https://www.schemastore.org/": true,
	},
	"mssql.connections": [],
	"sqltools.results.limit": 100,
	"mssql.openQueryResultsInTabByDefaultDoNotShowPrompt": true,
	"git.autofetch": true,
	"js/ts.updateImportsOnFileMove.enabled": "always",
	"editor.unicodeHighlight.nonBasicASCII": false,
	"mssql.autoDisableNonTSqlLanguageService": true,
	"editor.largeFileOptimizations": false,
	"sonarlint.automaticAnalysis": true,
	// SonarLint reads its rule list only from user settings (`sonarlint.rules` is application
	// scope): a repo's `.vscode/settings.json` cannot turn one off. The repos run the same SonarJS
	// rules through ESLint, which fails CI and shows them in the editor too, so SonarLint only drops
	// what ESLint decides otherwise: the rules it turns off (each with its reason in the repo's
	// `eslint.config.mjs`) and the ones it scopes to some folders, which SonarLint cannot scope and
	// would flag everywhere. TypeScript and JavaScript files have separate keys (`.mjs` hooks are
	// JavaScript), so each rule goes twice.
	"sonarlint.rules": {
		// Off everywhere: `no-await-in-loop` (a sequential loop is often required),
		// `no-alphabetical-sort` (`require-array-sort-compare` covers it), `no-unused-vars` (the
		// typescript-eslint rule covers it), the three strict-TypeScript duplicates
		// (`function-return-type`, `different-types-comparison`, `argument-type`) and
		// `prefer-nullish-coalescing` (ESLint runs it with options SonarLint cannot take).
		"typescript:S9382": { "level": "off" },
		"javascript:S9382": { "level": "off" },
		"typescript:S2871": { "level": "off" },
		"javascript:S2871": { "level": "off" },
		"typescript:S1481": { "level": "off" },
		"javascript:S1481": { "level": "off" },
		"typescript:S3800": { "level": "off" },
		"javascript:S3800": { "level": "off" },
		"typescript:S3403": { "level": "off" },
		"javascript:S3403": { "level": "off" },
		"typescript:S3782": { "level": "off" },
		"javascript:S3782": { "level": "off" },
		"typescript:S6606": { "level": "off" },
		"javascript:S6606": { "level": "off" },
		// Scoped by ESLint to tools and tests, where the input is the repo's own: commands from the
		// PATH, slow-backtracking regexes, cognitive complexity in scripts, and the test fixtures
		// (float equality, `http://`, fixed IPs, `/tmp`, seedless random, passwords, `eval`).
		"typescript:S4036": { "level": "off" },
		"javascript:S4036": { "level": "off" },
		"typescript:S8786": { "level": "off" },
		"javascript:S8786": { "level": "off" },
		"typescript:S3776": { "level": "off" },
		"javascript:S3776": { "level": "off" },
		"typescript:S1244": { "level": "off" },
		"javascript:S1244": { "level": "off" },
		"typescript:S5332": { "level": "off" },
		"javascript:S5332": { "level": "off" },
		"typescript:S1313": { "level": "off" },
		"javascript:S1313": { "level": "off" },
		"typescript:S5443": { "level": "off" },
		"javascript:S5443": { "level": "off" },
		"typescript:S2245": { "level": "off" },
		"javascript:S2245": { "level": "off" },
		"typescript:S2068": { "level": "off" },
		"javascript:S2068": { "level": "off" },
		"typescript:S1523": { "level": "off" },
		"javascript:S1523": { "level": "off" },
	},
	"[powershell]": {
		"editor.defaultFormatter": "ms-vscode.powershell",
	},
}
