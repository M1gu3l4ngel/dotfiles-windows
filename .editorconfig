# The repo's format conventions. VS Code, Neovim, JetBrains and others read it, so anyone who
# clones the repo writes in the same style with no setup. https://editorconfig.org
root = true

# Tabs by default (the editor uses insertSpaces=false, tabSize=2).
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

# Markdown: spaces, and no trimming (2 trailing spaces are a line break).
[*.md]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

# Shell (Git Bash): spaces, like the current .bashrc style. switch_case_indent is shfmt's own
# key: it indents `case` (like `-ci`). shfmt only reads .editorconfig when run without flags, as
# the mkhl.shfmt VS Code extension does.
[{.bashrc,.bash_profile,*.sh}]
indent_style = space
indent_size = 4
switch_case_indent = true

# YAML: the spec forbids tabs for indentation.
[*.{yml,yaml}]
indent_style = space
indent_size = 2
