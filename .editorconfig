# Convenciones de formato del repo. Lo leen VS Code, Neovim, JetBrains, etc.,
# así que cualquiera que lo clone escribe en el mismo estilo sin configurar nada.
# https://editorconfig.org
root = true

# ----- DEFAULT: tabs (el editor usa insertSpaces=false, tabSize=2) -----
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

# ----- MARKDOWN: espacios; no recortar (2 espacios finales = salto de línea) -----
[*.md]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

# ----- SHELL (Git Bash): espacios, como el estilo actual de los .bashrc -----
# switch_case_indent es clave propia de shfmt: indenta los `case` (equivale a
# `-ci`). shfmt solo lee .editorconfig cuando se ejecuta sin flags, como hace la
# extension mkhl.shfmt de VS Code.
[{.bashrc,.bash_profile,*.sh}]
indent_style = space
indent_size = 4
switch_case_indent = true

# ----- YAML: la especificacion prohibe tabuladores para indentar -----
[*.{yml,yaml}]
indent_style = space
indent_size = 2
