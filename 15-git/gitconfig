# The identity (`user.name`, `user.email`) belongs to each person and the signing key
# (`user.signingkey`) to each machine: both go in ~/.gitconfig.local, which bootstrap.ps1 fills
# from -GitName and -GitEmail. A fork never commits under the owner's name.
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[gpg]
	program = C:\\Program Files\\GnuPG\\bin\\gpg.exe
[tag]
	gpgsign = true
[http]
	postBuffer = 524288000
# The GitHub account follows the remote's owner, not the folder: every repo lives in
# D:/Dev/projects. Without this, Git Credential Manager asks which one to use on every fetch.
[includeIf "hasconfig:remote.*.url:https://github.com/M1gu3l4ngel/**"]
	path = ~/.gitconfig-personal
# What does not belong in a public repo (any organization, own, client or work, and its account)
# lives in this machine-local file, outside the repo. If it does not exist, git ignores it.
[include]
	path = ~/.gitconfig.local
