{
	"workbench.startupEditor": "none",
	"workbench.iconTheme": "symbols",
	"workbench.editor.tabSizing": "fixed",
	"workbench.editor.tabSizingFixedMaxWidth": 150,
	"workbench.colorTheme": "Monokai Night",
	"workbench.productIconTheme": "fluent-icons",
	"workbench.secondarySideBar.defaultVisibility": "hidden",
	"editor.wordWrap": "off",
	"editor.codeLens": true,
	"editor.minimap.enabled": false,
	"editor.formatOnSave": true,
	"editor.bracketPairColorization.enabled": true,
	"editor.scrollbar.verticalScrollbarSize": 8,
	"editor.scrollbar.horizontalScrollbarSize": 5,
	"editor.guides.bracketPairs": true,
	"editor.linkedEditing": true,
	"editor.fontLigatures": true,
	"editor.fontFamily": "Cascadia Code, Consolas, 'Courier New', monospace",
	"editor.cursorBlinking": "expand",
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.detectIndentation": false,
	"editor.tabSize": 2,
	"editor.insertSpaces": false,
	"editor.tokenColorCustomizations": {
		"comments": "#9a9c9a"
		// "comments": "#097409",
	},
	"terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font",
	"terminal.integrated.defaultProfile.windows": "PowerShell",
	"explorer.confirmDelete": false,
	"security.workspace.trust.banner": "never",
	// Guardar al cambiar de pestaña o de ventana, no por tiempo: el formateo al
	// guardar no se ejecuta en los guardados automáticos por retardo ("afterDelay").
	"files.autoSave": "onFocusChange",
	"files.eol": "\n",
	"css.enabledLanguages": ["html"],
	"explorer.confirmDragAndDrop": false,
	"auto-close-tag.enableAutoCloseTag": true,
	"auto-rename-tag.activationOnLanguage": ["html", "xml", "php", "javascript"],
	"auto-close-tag.activationOnLanguage": [
		"xml",
		"php",
		"blade",
		"ejs",
		"jinja",
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact",
		"plaintext",
		"markdown",
		"vue",
		"liquid",
		"erb",
		"lang-cfml",
		"cfml",
		"HTML (EEx)",
		"HTML (Eex)",
		"plist"
	],
	"terminal.integrated.profiles.windows": {
		"PowerShell": {
			"source": "PowerShell",
			"icon": "terminal-powershell"
		},
		"Command Prompt": {
			"path": ["${env:windir}\\Sysnative\\cmd.exe", "${env:windir}\\System32\\cmd.exe"],
			"args": [],
			"icon": "terminal-cmd"
		},
		"Git Bash": {
			"source": "Git Bash"
		},
		"Windows PowerShell": {
			"path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
		}
	},
	"importCost.debug": true,
	"html.format.wrapLineLength": 130,
	"git.enableSmartCommit": true,
	"php.validate.executablePath": "C:\\PHP\\php.exe",
	"symbols.hidesExplorerArrows": false,
	"editor.stickyScroll.enabled": false,
	// El estilo no vive aquí sino en archivos que también lee el CLI de Prettier:
	// el .prettierrc de cada proyecto o, si no tiene, el global (format/, enlazado
	// en ~ y en <disco>\Dev). Así el editor, la terminal y el CI formatean igual.
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnPaste": true,
	"mssql.connectionGroups": [
		{
			"name": "ROOT",
			"id": "ROOT"
		}
	],
	// Lo que Prettier no formatea, con su herramienta nativa. shfmt sin flags lee
	// el .editorconfig del proyecto (sangría y switch_case_indent).
	"[shellscript]": {
		"editor.defaultFormatter": "mkhl.shfmt"
	},
	"[sql]": {
		"editor.defaultFormatter": "mtxr.sqltools"
	},
	"sonarlint.connectedMode.connections.sonarcloud": [
		{
			"organizationKey": "m1gu3l4ngel",
			"connectionId": "m1gu3l4ngel",
			"region": "EU"
		}
	],
	"terminal.integrated.initialHint": false,
	"aiCommit.language": "es",
	"claudeCode.preferredLocation": "panel",
	"sqltools.highlightQuery": false,
	"json.schemaDownload.trustedDomains": {
		"https://developer.microsoft.com/json-schemas/": true,
		"https://json-schema.org/": true,
		"https://json.schemastore.org/": true,
		"https://raw.githubusercontent.com/devcontainers/spec/": true,
		"https://raw.githubusercontent.com/microsoft/vscode/": true,
		"https://schemastore.azurewebsites.net/": true,
		"https://ui.shadcn.com/schema.json": true,
		"https://www.schemastore.org/": true
	},
	"mssql.connections": [],
	"sqltools.results.limit": 100,
	"mssql.openQueryResultsInTabByDefaultDoNotShowPrompt": true,
	"gitCommitter.language": "es",
	"gitCommitter.apiKey": "",
	"gitCommitter.apiUrl": "http://localhost:3000",
	"git.autofetch": true,
	"js/ts.updateImportsOnFileMove.enabled": "always",
	"editor.unicodeHighlight.nonBasicASCII": false,
	"mssql.autoDisableNonTSqlLanguageService": true,
	"editor.largeFileOptimizations": false,
	"sonarlint.automaticAnalysis": true,
	"[powershell]": {
		"editor.defaultFormatter": "ms-vscode.powershell"
	}
}
