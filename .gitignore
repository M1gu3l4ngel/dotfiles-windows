# Backups install.ps1 makes before replacing a file
*.pre-dotfiles.bak

# Editor temp files
*.swp
*.swo
*~

# OS junk
Thumbs.db
desktop.ini
.DS_Store

# Sensitive data: never commit it.
# Personal and company literals for the hygiene check (tools/check.ps1 reads them):
tools/hygiene-patterns.local
.env
.env.*
*.key
*.pem
*_rsa
*_dsa
*_ed25519
secrets/

# VS Code MCP config (can hold tokens)
mcp.json
syncLocalSettings.json

# Local app snapshot, a private record: 60-apps/winget-full.local.json lists personal apps and
# stays on each machine.
*.local.json

# Local cache
.cache/
*.cache
*.log
*.tmp
