#!/bin/sh
# Git runs this after each `git pull` that brings changes (install.ps1 turns it on with
# core.hooksPath). It runs install.ps1 again to apply what the pull brought: new links and
# unregistered Claude Code hooks. The installer skips what is already done, so a pull with no news
# changes nothing.
# Prefers pwsh: PowerShell 5.1 needs admin to create symlinks even with Developer Mode on.
installer="$(git rev-parse --show-toplevel)/install.ps1"
if command -v pwsh >/dev/null 2>&1; then
	exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$installer"
fi
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$installer"
