# Every text file is stored as LF in the repo and checked out as LF, on any machine. This
# neutralizes core.autocrlf=true, which was adding CRLF.
* text=auto eol=lf

# Scripts that MUST keep LF even when edited on Windows.
*.ps1   text eol=lf
*.psm1  text eol=lf
*.sh    text eol=lf
*.bashrc      text eol=lf
*.bash_profile text eol=lf

# Binaries: git must never touch or normalize their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
